{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "backend",
        "path": "/static/$1"
      }
    },
    {
      "source": "/drop",
      "destination": {
        "service": "backend",
        "path": "/drop"
      }
    },
    {
      "source": "/anatomy-data/(.*)",
      "destination": "https://svitylo.com/anatomy-data/$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
